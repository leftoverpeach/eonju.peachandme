        .place-name { font-size: .9rem; font-weight: 700; color: #0f172a; }
        .place-sub { font-size: .75rem; color: #64748b; margin-top: 2px; }
        .place-dist { font-size: .75rem; font-weight: 700; color: #4f46e5; white-space: nowrap; }
        .map-link { display: inline-block; margin-top: 10px; font-size: .82rem; font-weight: 600; color: #4f46e5; text-decoration: none; }
