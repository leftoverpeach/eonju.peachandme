        .tag.selected { background-color: #ef4444; color: #fff; border-color: #ef4444; box-shadow: 0 2px 8px rgba(239,68,68,.25); }

        .badge-list { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
        .badge-info { display: inline-block; background-color: #fee2e2; color: #dc2626; font-size: .8rem; padding: 5px 12px; border-radius: 20px; font-weight: 600; }
        .badge-veg { display: inline-block; background-color: #d1fae5; color: #047857; font-size: .8rem; padding: 5px 12px; border-radius: 20px; font-weight: 600; }

