* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

body {
    background-color: #f0f2f5;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

.box {
    background: #ffffff;
    padding: 40px;
    border-radius: 20px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    text-align: center;
    width: 350px;
}

.emoji {
    font-size: 80px;
    margin: 20px 0;
}

.menu-name {
    font-size: 24px;
    font-weight: bold;
    color: #333333;
    min-height: 36px;
    margin-bottom: 30px;
}

button {
    width: 100%;
    background-color: #ff5722;
    color: #ffffff;
    border: none;
    padding: 15px 0;
    font-size: 16px;
    font-weight: bold;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

button:hover {
    background-color: #e64a19;
}

button:active {
    transform: scale(0.98);
}
