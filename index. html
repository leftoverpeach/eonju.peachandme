            105: { keyword: "브런치",       names: "오트밀|그래놀라|브런치",        cuisine: "breakfast|brunch" },
            106: { keyword: "샐러드",       names: "샐러드|샐러디|salad",           cuisine: "salad" },
            107: { keyword: "요거트",       names: "요거트|요구르트|요아정|아이스크림", cuisine: "ice_cream|frozen_yogurt" },
            108: { keyword: "수프",         names: "수프|스프|브런치|soup",         cuisine: "soup" },
            201: { keyword: "제육볶음",     names: "제육|백반|밥상|한식",           cuisine: "korean" },
            202: { keyword: "돈가스",       names: "돈가스|돈까스|카츠|가츠",       cuisine: "tonkatsu" },
            203: { keyword: "순두부찌개",   names: "순두부|두부",                   cuisine: "" },
            204: { keyword: "산채비빔밥",   names: "비빔밥|산채|나물",              cuisine: "" },
            205: { keyword: "쌀국수",       names: "쌀국수|pho|Pho",                cuisine: "vietnamese" },
            206: { keyword: "연어덮밥",     names: "연어|사케|덮밥|스시|초밥",      cuisine: "sushi|japanese" },
            207: { keyword: "파스타",       names: "파스타|스파게티|이탈리|피자",   cuisine: "italian|pasta" },
            208: { keyword: "칼국수",       names: "칼국수",                        cuisine: "" },
            209: { keyword: "두부요리",     names: "두부|스테이크|채식",            cuisine: "vegetarian|vegan" },
            301: { keyword: "삼겹살",       names: "삼겹|고기|구이|갈비",           cuisine: "korean_bbq|barbecue" },
            302: { keyword: "치킨",         names: "치킨|닭|BBQ|bbq|교촌|bhc",      cuisine: "chicken" },
            303: { keyword: "초밥",         names: "초밥|스시|회|사시미|sushi",     cuisine: "sushi" },
            304: { keyword: "곱창",         names: "곱창|막창|대창",                cuisine: "" },
            305: { keyword: "리조또",       names: "리조또|이탈리|파스타",          cuisine: "italian" },
            306: { keyword: "마라탕",       names: "마라|꿔바로우|훠궈",            cuisine: "" },
            307: { keyword: "피자",         names: "피자|pizza|Pizza",              cuisine: "pizza" },
            308: { keyword: "팟타이",       names: "팟타이|타이|태국|Thai",         cuisine: "thai" },
            309: { keyword: "파스타",       names: "파스타|스파게티|이탈리",        cuisine: "italian|pasta" }
        };

        const DEFAULT_POS = { lat: 37.5665, lng: 126.9780 }; // 서울시청 (위치 권한 거부 시)
        const OVERPASS_ENDPOINTS = [
            "https://overpass-api.de/api/interpreter",
            "https://overpass.kumi.systems/api/interpreter"
        ];

        /* ===================== 상태 ===================== */
        let selectedAllergens = new Set();
        let isVegetarianMode = false;
        let selectedMealTime = 'lunch';
        let currentMenuIds = new Set();
        let cachedUserPos = null;
        let openedCard = null;

        window.onload = function () { renderAllergyTags(); };

        window.navermap_authFailure = function () {
            document.querySelectorAll('.map-status').forEach(el => {
                el.classList.add('error');
                el.innerText = '⚠️ 네이버 지도 인증 실패: Client ID와 Web 서비스 URL(https://내아이디.github.io) 등록을 확인해 주세요.';
            });
        };

        /* ===================== 기존 기능 ===================== */
        function renderAllergyTags() {
            const container = document.getElementById('allergy-tags-container');
            container.innerHTML = '';
            ALLERGEN_OPTIONS.forEach(allergen => {
                const tag = document.createElement('div');
                tag.className = 'tag' + (selectedAllergens.has(allergen) ? ' selected' : '');
                tag.innerText = allergen;
                tag.onclick = () => toggleAllergen(allergen, tag);
                container.appendChild(tag);
            });
        }

        function toggleAllergen(allergen, element) {
            if (selectedAllergens.has(allergen)) { selectedAllergens.delete(allergen); element.classList.remove('selected'); }
            else { selectedAllergens.add(allergen); element.classList.add('selected'); }
        }

        function toggleVegetarian() {
            isVegetarianMode = !isVegetarianMode;
            const vegBtn = document.getElementById('veg-toggle-btn');
            if (isVegetarianMode) {
                vegBtn.classList.add('active-mode');
                vegBtn.innerHTML = '🥗 채식주의자 모드 적용 중 (클릭 시 해제)';
            } else {
                vegBtn.classList.remove('active-mode');
                vegBtn.innerHTML = '🥗 채식주의자인 경우';
            }
        }

        function toggleAllergySection() {
            const section = document.getElementById('allergy-section');
            section.style.display = (section.style.display === 'none' || section.style.display === '') ? 'block' : 'none';
        }

        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }
        function goHome() { showScreen('home-screen'); }
        function goToMealSelection() { showScreen('meal-time-screen'); }

        function selectMealTime(time) {
            selectedMealTime = time;
            currentMenuIds.clear();

            const titleMap = { breakfast: '🌅 아침 추천 메뉴', lunch: '☀️ 점심 추천 메뉴', dinner: '🌙 저녁 추천 메뉴' };
            document.getElementById('result-title').innerText = titleMap[time];
            showScreen('result-screen');

            const badgeContainer = document.getElementById('badge-container');
            badgeContainer.innerHTML = '';
            if (isVegetarianMode) badgeContainer.innerHTML += `<span class="badge-veg">🌱 채식주의 맞춤 식단</span>`;
            if (selectedAllergens.size > 0) badgeContainer.innerHTML += `<span class="badge-info">제외된 알레르기: ${Array.from(selectedAllergens).join(', ')}</span>`;

            getRecommendation();
        }

        function getRecommendation() {
            const loading = document.getElementById('loading');
            const list = document.getElementById('recommendation-list');
            loading.style.display = 'block';
            list.style.display = 'none';

            const menuPool = mealDatabase[selectedMealTime];
            let safeMenus = menuPool.filter(menu => {
                if (menu.allergens.some(a => selectedAllergens.has(a))) return false;
                if (isVegetarianMode && !menu.isVegetarian) return false;
                return true;
            });

            let candidateMenus = safeMenus.filter(m => !currentMenuIds.has(m.id));
            if (candidateMenus.length < 3) { candidateMenus = safeMenus; currentMenuIds.clear(); }

            const shuffled = [...candidateMenus].sort(() => 0.5 - Math.random());
            const selectedThree = shuffled.slice(0, 3);

            currentMenuIds.clear();
            selectedThree.forEach(m => currentMenuIds.add(m.id));

            setTimeout(() => {
                renderCards(selectedThree);
                loading.style.display = 'none';
                list.style.display = 'flex';
            }, 350);
        }

        function renderCards(menus) {
            const container = document.getElementById('recommendation-list');
            container.innerHTML = '';
            openedCard = null;

            if (menus.length === 0) {
                container.innerHTML = '<p style="color:#64748b; padding:24px;">선택하신 조건(채식/알레르기)을 만족하는 메뉴가 부족합니다. 😢<br>설정을 일부 변경해 주세요.</p>';
                return;
            }

            menus.forEach(menu => {
                const card = document.createElement('div');
                card.className = 'card';
                card.innerHTML = `
                    <div class="card-main">
                        <div class="card-emoji">${menu.emoji}</div>
                        <div class="card-info">
                            <div class="card-header">
                                <span class="card-title">${menu.name}</span>
                                <span class="card-meta">${menu.category} · ${menu.calories}</span>
                            </div>
                            <div class="card-desc">${menu.desc}</div>
                            <div class="card-action">📍 근처 식당 지도 보기</div>
                        </div>
                    </div>
                    <div class="card-map-area"></div>
                `;
                card.querySelector('.card-main').addEventListener('click', () => toggleCardMap(card, menu));
                container.appendChild(card);
            });
        }

        /* ===================== 네이버 지도 연동 ===================== */
        function toggleCardMap(card, menu) {
            if (card.classList.contains('open')) { closeCard(card); openedCard = null; return; }
            if (openedCard) closeCard(openedCard);

            card.classList.add('open');
            card.querySelector('.card-action').innerText = '📍 지도 닫기';
            openedCard = card;
            showRestaurantMap(menu, card.querySelector('.card-map-area'));
        }

        function closeCard(card) {
            card.classList.remove('open');
            card.querySelector('.card-action').innerText = '📍 근처 식당 지도 보기';
            card.querySelector('.card-map-area').innerHTML = '';
        }

        function isStillOpen(mapArea) {
            const card = mapArea.closest('.card');
            return mapArea.isConnected && card && card.classList.contains('open');
        }

        function getUserPosition() {
            return new Promise(resolve => {
                if (cachedUserPos) return resolve(cachedUserPos);
                if (!navigator.geolocation) return resolve({ ...DEFAULT_POS, isDefault: true });
                navigator.geolocation.getCurrentPosition(
                    p => { cachedUserPos = { lat: p.coords.latitude, lng: p.coords.longitude, isDefault: false }; resolve(cachedUserPos); },
                    () => resolve({ ...DEFAULT_POS, isDefault: true }),
                    { timeout: 8000, maximumAge: 60000 }
                );
            });
        }

        // 좌표 → "구 동" (네이버 지도 검색 링크용)
        function getAreaName(pos) {
            return new Promise(resolve => {
                if (!window.naver || !naver.maps || !naver.maps.Service) return resolve('');
                naver.maps.Service.reverseGeocode({
                    coords: new naver.maps.LatLng(pos.lat, pos.lng),
                    orders: [naver.maps.Service.OrderType.ADDR, naver.maps.Service.OrderType.ROAD_ADDR].join(',')
                }, (status, response) => {
                    if (status !== naver.maps.Service.Status.OK) return resolve('');
                    try {
                        const r = response.v2.results[0].region;
                        resolve(`${r.area2.name} ${r.area3.name}`.trim());
                    } catch (e) { resolve(''); }
                });
            });
        }

        // OpenStreetMap(Overpass)에서 주변 식당 검색
        async function fetchOverpass(pos, cfg, radius) {
            const types = '["amenity"~"restaurant|cafe|fast_food"]';
            let parts = `nwr(around:${radius},${pos.lat},${pos.lng})${types}["name"~"${cfg.names}"];`;
            if (cfg.cuisine) parts += `nwr(around:${radius},${pos.lat},${pos.lng})${types}["cuisine"~"${cfg.cuisine}"];`;
            const query = `[out:json][timeout:20];(${parts});out center 40;`;

            let lastErr;
            for (const endpoint of OVERPASS_ENDPOINTS) {
                try {
                    const ctrl = new AbortController();
                    const timer = setTimeout(() => ctrl.abort(), 20000);
                    const res = await fetch(endpoint + '?data=' + encodeURIComponent(query), { signal: ctrl.signal });
                    clearTimeout(timer);
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    return data.elements || [];
                } catch (e) { lastErr = e; }
            }
            throw lastErr;
        }

        function elementToPlace(el, pos) {
            const lat = el.lat ?? (el.center && el.center.lat);
            const lng = el.lon ?? (el.center && el.center.lon);
            const t = el.tags || {};
            const name = t['name:ko'] || t.name;
            if (lat == null || lng == null || !name) return null;
            const addr = [t['addr:city'], t['addr:district'], t['addr:street'], t['addr:housenumber']].filter(Boolean).join(' ');
            return { name, address: addr, cuisine: t.cuisine || '', lat, lng, dist: distanceMeters(pos.lat, pos.lng, lat, lng) };
        }

        function distanceMeters(lat1, lng1, lat2, lng2) {
            const R = 6371000, rad = d => d * Math.PI / 180;
            const dLat = rad(lat2 - lat1), dLng = rad(lng2 - lng1);
            const a = Math.sin(dLat / 2) ** 2 + Math.cos(rad(lat1)) * Math.cos(rad(lat2)) * Math.sin(dLng / 2) ** 2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }
        const formatDistance = m => m < 1000 ? `${Math.round(m)}m` : `${(m / 1000).toFixed(1)}km`;
        const escapeHtml = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

        async function showRestaurantMap(menu, mapArea) {
            mapArea.innerHTML = `
                <div class="map-status">📍 내 위치를 확인하는 중...</div>
                <div class="map-canvas"></div>
                <ul class="place-list"></ul>
                <div class="map-extra"></div>
            `;
            const status = mapArea.querySelector('.map-status');
            const canvas = mapArea.querySelector('.map-canvas');
            const listEl = mapArea.querySelector('.place-list');
            const extra = mapArea.querySelector('.map-extra');
            const cfg = SEARCH_CONFIG[menu.id] || { keyword: menu.name, names: menu.name, cuisine: '' };

            if (!window.naver || !naver.maps) {
                status.classList.add('error');
                status.innerText = '⚠️ 네이버 지도를 불러오지 못했습니다. index.html 상단의 Client ID(ncpKeyId)를 확인해 주세요.';
                canvas.style.display = 'none';
                return;
            }

            const pos = await getUserPosition();
            if (!isStillOpen(mapArea)) return;

            const myLatLng = new naver.maps.LatLng(pos.lat, pos.lng);
            const map = new naver.maps.Map(canvas, { center: myLatLng, zoom: 15 });
            new naver.maps.Marker({
                position: myLatLng, map, title: '내 위치',
                icon: { content: '<div class="my-marker"></div>', anchor: new naver.maps.Point(11, 11) }
            });

            status.innerText = pos.isDefault
                ? '📍 현재 위치를 가져올 수 없어 서울시청 주변을 보여드려요. (브라우저 위치 권한을 허용해 보세요) 식당을 찾는 중...'
                : `🔎 근처 '${cfg.keyword}' 식당을 찾는 중...`;

            // 네이버 지도에서 직접 검색하는 링크 (검색 결과가 부족할 때 대비, 항상 표시)
            getAreaName(pos).then(area => {
                if (!isStillOpen(mapArea)) return;
                const q = encodeURIComponent(`${area} ${cfg.keyword}`.trim());
                extra.innerHTML = `
                    <a class="map-link" href="https://map.naver.com/p/search/${q}" target="_blank" rel="noopener">🔍 네이버 지도에서 '${escapeHtml(cfg.keyword)}' 더 찾아보기 ↗</a>
                    <div class="map-credit">식당 정보 © OpenStreetMap contributors</div>
                `;
            });

            try {
                let elements = await fetchOverpass(pos, cfg, 1500);
                if (elements.length === 0) elements = await fetchOverpass(pos, cfg, 3000); // 반경 확대
                if (!isStillOpen(mapArea)) return;

                // 중복 제거 후 가까운 순 정렬
                const seen = new Set();
                const places = elements.map(e => elementToPlace(e, pos)).filter(Boolean)
                    .sort((a, b) => a.dist - b.dist)
                    .filter(p => { const k = p.name + Math.round(p.lat * 1e4); if (seen.has(k)) return false; seen.add(k); return true; })
                    .slice(0, 8);

                if (places.length === 0) {
                    status.innerText = `😢 근처에서 '${cfg.keyword}' 식당 정보를 찾지 못했어요. 아래 링크로 네이버 지도에서 직접 검색해 보세요.`;
                    return;
                }

                const bounds = new naver.maps.LatLngBounds(myLatLng, myLatLng);
                const infoWindow = new naver.maps.InfoWindow({ borderWidth: 1, anchorSize: new naver.maps.Size(10, 10) });

                const openInfo = (place, marker) => {
                    const link = `https://map.naver.com/p/search/${encodeURIComponent(place.name)}`;
                    infoWindow.setContent(`
                        <div class="info-window">
                            <strong>${escapeHtml(place.name)}</strong><br>
                            ${place.address ? escapeHtml(place.address) + '<br>' : ''}
                            <a href="${link}" target="_blank" rel="noopener">네이버 지도에서 보기 ↗</a>
                        </div>`);
                    infoWindow.open(map, marker);
                };

                places.forEach((place, i) => {
                    const latlng = new naver.maps.LatLng(place.lat, place.lng);
                    const marker = new naver.maps.Marker({ position: latlng, map, title: place.name });
                    bounds.extend(latlng);
                    naver.maps.Event.addListener(marker, 'click', () => openInfo(place, marker));

                    const li = document.createElement('li');
                    li.className = 'place-item';
                    li.innerHTML = `
                        <div>
                            <div class="place-name">${i + 1}. ${escapeHtml(place.name)}</div>
                            ${place.address ? `<div class="place-sub">${escapeHtml(place.address)}</div>` : ''}
                        </div>
                        <div class="place-dist">${formatDistance(place.dist)}</div>`;
                    li.addEventListener('click', () => { map.panTo(latlng); openInfo(place, marker); });
                    listEl.appendChild(li);
                });

                map.fitBounds(bounds, { top: 30, right: 30, bottom: 30, left: 30 });
                status.innerText = `✅ ${pos.isDefault ? '서울시청 주변 ' : '근처 '}'${cfg.keyword}' 식당 ${places.length}곳 (가까운 순)`;
            } catch (err) {
                console.error(err);
                status.classList.add('error');
                status.innerText = '⚠️ 식당 정보를 불러오지 못했어요. 잠시 후 다시 시도하거나 아래 링크로 네이버 지도에서 직접 검색해 보세요.';
            }
        }
    </script>
